<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Bootcraft</vendor>
  <vendor_url>https://github.com/ArcticLatent/Bootcraft</vendor_url>

  <!-- The app runs `pkexec /usr/lib/bootcraft/bootcraft-helper serve` once per setup run.
       The helper accepts task IDs from its own catalog only. -->
  <action id="io.github.arcticlatent.bootcraft.apply">
    <description>Set up this computer with Bootcraft</description>
    <message>Bootcraft needs administrator access to install and configure software.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/bootcraft/bootcraft-helper</annotate>
  </action>
</policyconfig>
